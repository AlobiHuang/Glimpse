# Copy this file to ".env" and fill in the values from
# Supabase → Project Settings → API Keys. Leave them empty to run on demo data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shown in the app as your support contact (Apple requires one for apps with user posts).
EXPO_PUBLIC_CONTACT_EMAIL=

# Your public web address (used in shared photo links). Defaults to https://glimpse.place
EXPO_PUBLIC_WEB_URL=
